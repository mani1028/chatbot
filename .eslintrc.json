{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "SITE_ID": "readonly",
    "CONFIG": "readonly"
  },
  "rules": {
    "no-undef": "warn",
    "no-unused-vars": "warn"
  }
}






























































































































































































































































































































































































































































































































































































































